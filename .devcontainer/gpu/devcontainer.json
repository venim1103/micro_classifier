{
  "name": "Micro Classifier (CUDA, Docker)",
  "initializeCommand": ["bash", "${localWorkspaceFolder}/.devcontainer/prepare-build.sh"],
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "DEPENDENCY_LOCK": "gpu/requirements.lock",
      "TORCH_INDEX_URL": "https://download.pytorch.org/whl/cu128"
    },
    "options": ["--platform=linux/amd64"]
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "hostRequirements": {"gpu": true},
  "runArgs": ["--shm-size=2g", "--gpus", "all"],
  "containerEnv": {
    "MICRO_CLASSIFIER_DEVICE": "cuda",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility"
  },
  "mounts": [
    "source=micro-classifier-cache-${devcontainerId},target=/home/vscode/.cache,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer/tools,target=/opt/st-tools,type=bind,readonly"
  ],
  "postCreateCommand": ["/opt/venv/bin/python", "${containerWorkspaceFolder}/.devcontainer/smoke.py"],
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "marus25.cortex-debug"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "cmake.configureOnOpen": false,
        "cortex-debug.armToolchainPath": "/usr/bin",
        "cortex-debug.gdbPath": "/usr/bin/gdb-multiarch"
      }
    }
  }
}
